# LOCAL DEVELOPMENT ONLY. Read by the Vite dev proxy in `vite.config.ts` so
# that `/api/v1/*` reaches the Laravel console during `npm run dev`.
#
# In production this variable is NOT used: Vercel proxies `/api/v1/*` through
# the `rewrites` block in `vercel.json`, and Vercel rewrites cannot read
# environment variables. If the backend host changes, edit vercel.json.
API_ORIGIN=https://console.moatasem.dev

# Escape hatch: point the browser straight at the API instead of going through
# the same-origin proxy. Leave it unset — setting it puts the backend host back
# into the JavaScript bundle and brings CORS back with it.
# VITE_API_URL=

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
