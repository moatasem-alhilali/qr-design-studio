# Where the Laravel console lives. Server-side only: it is read by the dev
# proxy and by the /api/v1 edge function, and never reaches the browser bundle.
API_ORIGIN=ss

# Optional escape hatch: point the browser straight at the API instead of going
# through the same-origin proxy. Leave it unset for normal builds — setting it
# puts the backend host back into the bundle.
# VITE_API_URL=

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
